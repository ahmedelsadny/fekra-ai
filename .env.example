# Node & Environment
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://fekra_user:fekra_secure_password@localhost:5432/fekra_ai?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Authentication (Argon2id + JWT)
JWT_ACCESS_SECRET="fekra-ai-super-secret-access-token-key-change-in-prod-2026"
JWT_REFRESH_SECRET="fekra-ai-super-secret-refresh-token-key-change-in-prod-2026"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Applications
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Storage (S3 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=fekra-uploads
STORAGE_ACCESS_KEY=fekra_admin
STORAGE_SECRET_KEY=fekra_minio_password

# Email / Notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@fekra.ai
SMTP_PASSWORD=smtp_password
